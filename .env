# Telegram Bot Configuration
# Get your bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Configuration
# Sign up and get API key at https://openrouter.ai/settings/credits
# Don't forget to add credits to your account
OPENROUTER_API_KEY=your_openrouter_api_key_here

# SerpAPI Configuration
# Get your API key at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# AI Model Selection
# Options:
# - anthropic/claude-3.5-sonnet (recommended, balanced)
# - anthropic/claude-3-opus (highest quality, more expensive)
# - anthropic/claude-3-haiku (fastest, cheapest)
AI_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter API Base URL (don't change unless necessary)
AI_BASE_URL=https://openrouter.ai/api/v1
